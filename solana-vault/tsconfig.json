{
  "compilerOptions": {
    "types": ["node", "chai"],
    "lib": ["es2022"],
    "module": "commonjs",
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./ts-tests",
    "sourceMap": true
  },
  "include": ["tests/**/*.ts", "migrations/**/*.ts"]
}